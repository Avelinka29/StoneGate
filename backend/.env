# Конфигурация приложения
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Настройки PostgreSQL
# Для инициализации базы данных (права суперпользователя)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# URL для подключения к приложению (после создания БД)
DATABASE_URL=postgresql://stonegate_user:stonegate_password@localhost:5432/stonegate_db

# Альтернатива: использовать SQLite для разработки
# USE_SQLITE=true
